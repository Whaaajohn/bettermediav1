NODE_ENV=development
LOCAL_DEV=true
HOST=0.0.0.0
PORT=5174
ADMIN_PORT=5175
API_BASE_URL=http://localhost:5174
CLIENT_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

JWT_SECRET=better-media-docker-local-only
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

DB_DRIVER=local_json
LOCAL_DB_FILE=./data/db.json
AUTO_BACKUP_DB=true
DB_BACKUP_DIR=./data/backups

UPLOAD_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:5174/uploads

REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READONLY_TOKEN=
UPSTASH_REDIS_TIMEOUT_MS=10000
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=15000
SMTP_ENABLED=false
OLLAMA_ENABLED=false
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
SIGHTENGINE_ENABLED=false

BOT_ENGINE_ENABLED=true
BOT_LOCAL_AI_ENABLED=true
BOT_LOCAL_FILES_ONLY=true
LOCAL_AI_ENABLED=true
LOCAL_AI_HF_ENABLED=true
HF_LOCAL_FILES_ONLY=true
BOT_MODEL_CACHE_DIR=./data/models
HF_HOME=./data/models

SOCKET_IO_ENABLED=true
CALL_SIGNALING_ENABLED=true
LOG_HTTP=true
LOG_SOCKET=true
